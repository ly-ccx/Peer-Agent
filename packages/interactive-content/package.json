{
  "name": "@peer-agent/interactive-content",
  "version": "0.1.0-rc.38",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./values": {
      "types": "./src/values.d.ts",
      "default": "./src/limits.mjs"
    },
    "./state": {
      "types": "./src/state.d.ts",
      "default": "./src/state.mjs"
    },
    "./context": {
      "types": "./src/context.d.ts",
      "default": "./src/context.generated.mjs"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build-context.mjs && node --check src/index.mjs",
    "typecheck": "node --check src/index.mjs",
    "test": "OPENUI_TELEMETRY_DISABLED=1 node --test src/*.test.mjs"
  },
  "dependencies": {
    "@openuidev/lang-core": "1.0.0",
    "@peer-agent/protocol": "workspace:*",
    "zod": "4.4.3"
  }
}
