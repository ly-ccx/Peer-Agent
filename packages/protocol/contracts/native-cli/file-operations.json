{
  "schemaVersion": 1,
  "provenance": {
    "reference": "Actual current createNodeFileProvider over isolated files, plus actual Node Intl locale observations. Not native/Host authorization acceptance."
  },
  "cases": [
    {
      "name": "list-and-search",
      "files": {
        "a.txt": "Needle one\r\nneedle two\nalpha beta beta",
        "B.txt": "needle three",
        "docs/z.txt": "a Needle\nlast\r",
        "node_modules/dependency": "needle ignored",
        ".git/object": "needle ignored",
        "binary.bin": {
          "hex": "004e6565646c65"
        },
        "bad-utf8.txt": {
          "hex": "ff4e6565646c65"
        }
      },
      "steps": [
        {
          "capability": "local.file.list",
          "args": {
            "path": "."
          },
          "expected": {
            "status": "completed",
            "output": {
              "path": ".",
              "entries": [
                {
                  "name": ".git",
                  "path": ".git",
                  "type": "directory"
                },
                {
                  "name": "a.txt",
                  "path": "a.txt",
                  "type": "file"
                },
                {
                  "name": "B.txt",
                  "path": "B.txt",
                  "type": "file"
                },
                {
                  "name": "bad-utf8.txt",
                  "path": "bad-utf8.txt",
                  "type": "file"
                },
                {
                  "name": "binary.bin",
                  "path": "binary.bin",
                  "type": "file"
                },
                {
                  "name": "docs",
                  "path": "docs",
                  "type": "directory"
                },
                {
                  "name": "node_modules",
                  "path": "node_modules",
                  "type": "directory"
                }
              ]
            },
            "error": null
          }
        },
        {
          "capability": "local.file.search",
          "args": {
            "query": "needle"
          },
          "expected": {
            "status": "completed",
            "output": {
              "query": "needle",
              "path": ".",
              "matches": [
                {
                  "path": "B.txt",
                  "line": 1,
                  "text": "needle three"
                },
                {
                  "path": "a.txt",
                  "line": 1,
                  "text": "Needle one"
                },
                {
                  "path": "a.txt",
                  "line": 2,
                  "text": "needle two"
                },
                {
                  "path": "bad-utf8.txt",
                  "line": 1,
                  "text": "�Needle"
                },
                {
                  "path": "docs/z.txt",
                  "line": 1,
                  "text": "a Needle"
                }
              ],
              "matchCount": 5,
              "truncated": false
            },
            "error": null
          }
        },
        {
          "capability": "local.file.search",
          "args": {
            "query": "Needle",
            "case_sensitive": true
          },
          "expected": {
            "status": "completed",
            "output": {
              "query": "Needle",
              "path": ".",
              "matches": [
                {
                  "path": "a.txt",
                  "line": 1,
                  "text": "Needle one"
                },
                {
                  "path": "bad-utf8.txt",
                  "line": 1,
                  "text": "�Needle"
                },
                {
                  "path": "docs/z.txt",
                  "line": 1,
                  "text": "a Needle"
                }
              ],
              "matchCount": 3,
              "truncated": false
            },
            "error": null
          }
        },
        {
          "capability": "local.file.search",
          "args": {
            "path": "a.txt",
            "query": "needle",
            "max_results": 1
          },
          "expected": {
            "status": "completed",
            "output": {
              "query": "needle",
              "path": "a.txt",
              "matches": [
                {
                  "path": "a.txt",
                  "line": 1,
                  "text": "Needle one"
                }
              ],
              "matchCount": 1,
              "truncated": true
            },
            "error": null
          }
        },
        {
          "capability": "local.file.search",
          "args": {
            "path": "docs",
            "query": "\r",
            "case_sensitive": true
          },
          "expected": {
            "status": "failed",
            "output": null,
            "error": "invalid_query"
          }
        }
      ]
    },
