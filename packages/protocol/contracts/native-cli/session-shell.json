      "expected": {
        "kind": "error",
        "message": "peer sessions: --yes is only valid with delete",
        "exitCode": 2
      }
    },
    {
      "argv": [
        "sessions",
        "--bogus"
      ],
      "expected": {
        "kind": "error",
        "message": "peer sessions: unknown option --bogus",
        "exitCode": 2
      }
    },
    {
      "argv": [
