      }
    },
    {
      "argv": [
        "doctor",
        "--bogus"
      ],
      "expected": {
        "kind": "error",
        "message": "peer doctor: unknown option --bogus",
        "exitCode": 2
      }
    },
    {
      "argv": [
        "doctor",
        "--help"
      ],
      "expected": {
        "kind": "help",
        "topic": "doctor"
      }
    },
    {
      "argv": [
        "export"
