    {
      "argv": [
        "export",
        "a"
      ],
      "expected": {
        "kind": "export",
        "sessionId": "a",
        "force": false
      }
    },
    {
      "argv": [
        "export",
        "a",
        "--output",
        "out.md",
        "--force"
      ],
      "expected": {
        "kind": "export",
        "sessionId": "a",
        "outputPath": "out.md",
        "force": true
      }
    },
    {
      "argv": [
        "export",
        "--output=out.md",
        "a"
      ],
      "expected": {
        "kind": "export",
        "sessionId": "a",
        "outputPath": "out.md",
        "force": false
      }
    },
    {
      "argv": [
        "export",
        "a",
        "--output"
      ],
      "expected": {
        "kind": "error",
        "message": "peer export: --output requires a path",
