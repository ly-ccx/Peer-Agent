{
  "name": "@peer-agent/runtime-core",
  "version": "0.0.1-beta.43",
  "description": "Host-neutral capability, permission, projection, and Evidence primitives for Peer Agent runtimes.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yinLiangDream/Peer-Agent.git",
    "directory": "packages/runtime-core"
  },
  "homepage": "https://github.com/yinLiangDream/Peer-Agent#readme",
  "bugs": {
    "url": "https://github.com/yinLiangDream/Peer-Agent/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@peer-agent/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
