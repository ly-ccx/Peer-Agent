{
  "name": "@peer-agent/runtime-node",
  "version": "0.1.0-rc.42",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": "./src/testing/scripted-turn-executor.mjs",
    "./storage": {
      "types": "./dist/storage-public.d.ts",
      "default": "./dist/storage-public.js"
    },
    "./models": {
      "types": "./dist/models-public.d.ts",
      "default": "./dist/models-public.js"
    },
    "./providers": {
      "types": "./dist/providers-public.d.ts",
      "default": "./dist/providers-public.js"
    },
    "./obligation-log": "./dist/project-agent/obligation-log.mjs",
    "./execution-obligation": "./dist/project-agent/execution-obligation.mjs",
    "./work-budget": "./dist/project-agent/work-budget.mjs",
    "./diagnostic-phase": "./dist/diagnostic-phase.mjs",
    "./goal-plan-files": "./dist/goal-plan-files.mjs",
    "./project-agent": {
      "types": "./dist/project-agent-public.d.ts",
      "default": "./dist/project-agent-public.js"
    },
    "./interactive-results": {
      "types": "./dist/interactive-results-public.d.ts",
      "default": "./dist/interactive-results-public.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/embed-storage-workers.mjs && node scripts/embed-project-tool-prompts.mjs && node scripts/embed-interactive-worker.mjs && tsc -p tsconfig.build.json && node scripts/emit-declared-modules.mjs",
    "test": "node scripts/test-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@peer-agent/protocol": "workspace:*",
    "@peer-agent/runtime-core": "workspace:*",
    "@peer-agent/runtime-sdk": "workspace:*",
    "adm-zip": "^0.5.17",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "@peer-agent/interactive-content": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.27.7",
    "typescript": "^5.9.3"
  }
}
