{
  "name": "@peer-agent/runtime-node",
  "version": "0.1.0-rc.28",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": "./src/testing/scripted-turn-executor.mjs",
    "./storage": {
      "types": "./dist/storage-public.d.ts",
      "default": "./dist/storage-public.js"
    },
    "./models": {
      "types": "./dist/models-public.d.ts",
      "default": "./dist/models-public.js"
    },
    "./providers": {
      "types": "./dist/providers-public.d.ts",
      "default": "./dist/providers-public.js"
    },
    "./project-agent": {
      "types": "./dist/project-agent-public.d.ts",
      "default": "./dist/project-agent-public.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/embed-storage-workers.mjs && node scripts/embed-project-tool-prompts.mjs && tsc -p tsconfig.build.json && node scripts/emit-declared-modules.mjs",
    "test": "node --test src/*.test.ts src/*.test.mjs src/sqlite/*.test.mjs src/memory/*.test.mjs src/project-agent/*.test.mjs src/project-agent/probes/*.test.mjs src/testing/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@peer-agent/protocol": "workspace:*",
    "@peer-agent/runtime-core": "workspace:*",
    "@peer-agent/runtime-sdk": "workspace:*",
    "@qoder-ai/qoder-agent-sdk": "^1.0.15",
    "adm-zip": "^0.5.17",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
