{
  "name": "@peer-agent/system-context",
  "version": "0.0.1-beta.41",
  "description": "Canonical Node System Context assembler and Prompt Sources shared by Peer Agent hosts.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./host-config-instructions": {
      "types": "./src/host-config-instructions.d.ts",
      "default": "./src/host-config-instructions.mjs"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node --check src/index.mjs",
    "test": "node --test src/*.test.mjs",
    "typecheck": "node --check src/index.mjs"
  },
  "dependencies": {
    "@peer-agent/runtime-core": "workspace:*"
  }
}
