# Zeus Atlas production E2E template.
# Copy to a local .env file or export these variables in your shell.
# Do not add client_secret for the desktop PKCE flow.

ZEUS_ATLAS_BUC_ENV=prod
ZEUS_ATLAS_BUC_CLIENT_ID=cbu-xiaoer-node-service
ZEUS_ATLAS_BUC_REDIRECT_URI=http://127.0.0.1:16888/oauth/callback
ZEUS_ATLAS_BUC_LOGOUT_BACK_URL=http://127.0.0.1:16888/logout/callback
ZEUS_ATLAS_BUC_SCOPE=profile openid

# Must be a production https URL for prod E2E. Do not use pre hosts.
ZEUS_ATLAS_CLOUD_GATEWAY_URL=https://cbu-xiaoer-service.alibaba-inc.com
# Runtime Gateway is a separate WS entrypoint. Do not point it at node-service.
# ZEUS_ATLAS_RUNTIME_GATEWAY_URL=wss://your-runtime-gateway-host
# Developer mode: routes Cloud Chat/Gateway/SSE requests to pre by default.
# ZEUS_ATLAS_DEVELOPER_MODE=pre
# ZEUS_ATLAS_PRE_CLOUD_GATEWAY_URL=https://pre-cbu-xiaoer-service.alibaba-inc.com
# ZEUS_ATLAS_PRE_RUNTIME_GATEWAY_URL=wss://your-pre-runtime-gateway-host
# Optional when SSE needs a different direct pre endpoint.
# ZEUS_ATLAS_PRE_CLOUD_STREAM_URL=https://pre-cbu-xiaoer-service.alibaba-inc.com
ZEUS_ATLAS_CLIENT_TOOL_RESULT_PATH=/api/chat/client-tool/result
ZEUS_ATLAS_CLIENT_TOOL_POLL_PATH=/api/client/runtime/tasks/poll
ZEUS_ATLAS_RUNTIME_PROJECTION_PATH=/api/client/runtime/projection
