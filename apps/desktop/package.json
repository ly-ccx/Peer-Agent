{
  "name": "@zeus-atlas/desktop",
  "version": "0.0.1",
  "description": "Zeus Atlas Desktop - AI Agent OS for Enterprise",
  "author": "Zeus OS Team <zeus-os@alibaba-inc.com>",
  "private": true,
  "type": "module",
  "main": "electron/main/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "test": "node --test electron/main/*.test.mjs renderer/src/chat/state/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "publish:stable": "bash scripts/publish.sh stable",
    "publish:beta": "bash scripts/publish.sh beta"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@zeus-atlas/chat-kernel": "workspace:*",
    "@zeus-atlas/i18n": "workspace:*",
    "@zeus-atlas/protocol": "workspace:*",
    "@zeus-atlas/task-thread": "workspace:*",
    "@zeus-atlas/ui": "workspace:*",
    "adm-zip": "^0.5.17",
    "electron-updater": "^6.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.4",
    "ws": "^8.20.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  },
  "repository": "git@gitlab.alibaba-inc.com:zeus_os/zeus_atlas.git"
}