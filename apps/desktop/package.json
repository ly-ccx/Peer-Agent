{
  "name": "@peer-agent/desktop",
  "version": "0.0.1-beta.5",
  "description": "Peer Agent Desktop - AI Agent OS for Enterprise",
  "author": "Peer Agent Team <dev@peer-agent.local>",
  "private": true,
  "type": "module",
  "main": "electron/main/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "test": "node --test \"electron/main/**/*.test.mjs\" \"renderer/src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "publish:stable": "bash scripts/publish.sh stable",
    "publish:beta": "bash scripts/publish.sh beta",
    "dev:lab": "concurrently -k \"cross-env PEER_DEV_PORT=5273 vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5273 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5273 PEER_AGENT_HOME=$HOME/.peer-agent-lab electron .\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@peer-agent/chat-kernel": "workspace:*",
    "@peer-agent/i18n": "workspace:*",
    "@peer-agent/protocol": "workspace:*",
    "@peer-agent/task-thread": "workspace:*",
    "@peer-agent/ui": "workspace:*",
    "@vitejs/plugin-react": "^5.1.0",
    "adm-zip": "^0.5.17",
    "electron-updater": "^6.8.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3"
  },
  "repository": ""
}
